# Copy to .env and fill in the values:  cp .env.example .env

# --- Required ---------------------------------------------------------------
# Free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# --- Local development ----------------------------------------------------------
# 1 = debug pages and auto-generated dev secret key. docker-compose forces 0.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Docker: admin user created on first start ------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-too
# 1 = upload the files in sample_data/ on startup
LOAD_SAMPLE_DATA=1

# --- Docker build: only if Docker Hub is blocked on your network (403 Forbidden) --
# Same official Python image, served from Amazon's registry instead:
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.11-slim

# --- Optional tuning (defaults shown) -------------------------------------------
# Pick any model from https://openrouter.ai/collections/free-models
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_SECONDS=60
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# RETRIEVAL_TOP_K=5
# MAX_UPLOAD_SIZE_MB=10
# ASK_RATE_LIMIT=20/min
